# font_family      RobotoMono Nerd Font Medium
# font_family      BlexMono Nerd Font Medium
# font_family      Departure Mono
# font_family      Liga SFMonoNerdFont Medium
# font_family      GeistMono NF Medium
# font_family      Commit Mono

font_family GeistMono NFM Medium
# bold_font auto
# italic_font auto
# bold_italic_font auto

font_size 12
cursor none
cursor_shape block

cursor_blink_interval 0

scrollback_lines 10000

map ctrl+shift+h launch --stdin-source=@screen_scrollback --type=overlay helix -

enable_audio_bell no

draw_minimal_borders yes
placement_strategy center
inactive_text_alpha 1.0

# hide_window_decorations yes

include themes/dark.conf
# include themes/light.conf

startup_session default_session.kitty

shell_integration no-title no-cursor

map ctrl+equal change_font_size all +1.0
map ctrl+minus change_font_size all -1.0
